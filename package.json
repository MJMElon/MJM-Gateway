{
  "name": "mjm-intranet",
  "version": "1.0.0",
  "private": true,
  "description": "MJM Intranet：纯 HTML 静态网站（GitHub Pages 从分支发布），这里只放本地开发用的工具",
  "scripts": {
    "serve": "npx --yes serve -l 3000 .",
    "key": "node scripts/generate-token-key.mjs",
    "seed": "node --env-file=.env.local scripts/seed-local.mjs",
    "build:css": "tailwindcss -i shared/tailwind.src.css -o shared/app.css --minify"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/cli": "^4.1.11",
    "jose": "^5.10.0",
    "tailwindcss": "^4.1.11"
  }
}